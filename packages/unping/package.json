{
  "name": "unping",
  "version": "0.0.3",
  "description": "Unified network ping library with multi-driver support",
  "keywords": [
    "connectivity",
    "dns",
    "http",
    "latency",
    "monitoring",
    "network",
    "ping",
    "tcp",
    "typescript"
  ],
  "homepage": "https://github.com/funish/axis#readme",
  "bugs": {
    "url": "https://github.com/funish/axis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Funish",
    "email": "contact@funish.net",
    "url": "http://www.funish.net/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funish/axis.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./drivers/*": {
      "types": "./dist/drivers/*.d.mts",
      "import": "./dist/drivers/*.mjs"
    }
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "vp pack",
    "prepack": "pnpm build",
    "release": "basis publish"
  },
  "dependencies": {
    "ofetch": "1.4.1"
  }
}
