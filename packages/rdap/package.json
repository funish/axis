{
  "name": "rdap",
  "version": "0.0.14",
  "description": "Modern RDAP client and server with RFC compliance, bootstrap service, and h3 integration",
  "keywords": [
    "asn",
    "bootstrap",
    "client",
    "domain",
    "h3",
    "icann",
    "ip",
    "rdap",
    "registry",
    "rfc",
    "server",
    "whois"
  ],
  "homepage": "https://github.com/funish/axis#readme",
  "bugs": {
    "url": "https://github.com/funish/axis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Funish",
    "email": "contact@funish.net",
    "url": "http://www.funish.net/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funish/axis.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    }
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "vp pack",
    "prepack": "pnpm build",
    "release": "basis publish"
  },
  "dependencies": {
    "h3": "2.0.1-rc.5",
    "ipdo": "workspace:*",
    "ofetch": "1.4.1"
  }
}
