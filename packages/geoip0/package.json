{
  "name": "geoip0",
  "version": "0.0.13",
  "description": "Unified geolocation information query library with multi-provider and fallback support",
  "keywords": [
    "asn",
    "fallback",
    "geoip",
    "geolocation",
    "geolocation-api",
    "ip",
    "ip-address",
    "ip-location",
    "ipv4",
    "ipv6",
    "isp",
    "location",
    "maxmind",
    "mmdb",
    "multi-driver",
    "rdap",
    "registry-data",
    "typescript"
  ],
  "homepage": "https://github.com/funish/axis#readme",
  "bugs": {
    "url": "https://github.com/funish/axis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Funish",
    "email": "contact@funish.net",
    "url": "http://www.funish.net/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funish/axis.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./drivers/*": {
      "types": "./dist/drivers/*.d.mts",
      "import": "./dist/drivers/*.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./mmdb": {
      "types": "./dist/mmdb.d.mts",
      "import": "./dist/mmdb.mjs"
    }
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "vp pack",
    "prepack": "pnpm build",
    "release": "basis publish"
  },
  "dependencies": {
    "h3": "2.0.1-rc.5",
    "ipdo": "workspace:*",
    "ofetch": "1.4.1",
    "rdap": "workspace:*",
    "undio": "0.2.0"
  }
}
