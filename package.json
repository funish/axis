  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funish/axis.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" -r dev",
    "build": "pnpm --filter \"./packages/*\" -r build",
